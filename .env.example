# Copy to .env and fill in. Never commit .env.
MODEL_API_KEY=
# Model used for development runs (Standard mode)
OIQ_MODEL=muse-spark-1.3
# Hard spend limits enforced in code (the Billing "spend limit" only sends an email)
OIQ_DAILY_USD=3
OIQ_MAX_CALLS_PER_RUN=40
# Set to off to block every paid call
OIQ_PAID=on
# Baseten key for open-weights Muse Spark (optional)
BASETEN_API_KEY=
# Fireworks key for the same open weights on a second host (optional)
FIREWORKS_API_KEY=
# Per-provider daily limits in dollars (each provider is a separate account)
# OIQ_BASETEN_DAILY_USD=3
# OIQ_FIREWORKS_DAILY_USD=3

# Alert emails (optional). Without these, alerts appear in the console and are saved as files.
# For Gmail: smtp.gmail.com, port 587, your address, and an app password you create yourself.
# OIQ_SMTP_HOST=smtp.gmail.com
# OIQ_SMTP_PORT=587
# OIQ_SMTP_USER=you@gmail.com
# OIQ_SMTP_PASS=
# OIQ_ALERT_TO=you@gmail.com      # default recipient; the Monitor dialog can set another
